# wrangler 4.12x declares a peerOptional on @cloudflare/workers-types@^5, but
# `agents`/partyserver still peer-depend on v4. Since the wrangler peer is
# OPTIONAL, honoring v4 (what our runtime types must match) is correct. This
# flag stops npm's strict peer resolver from erroring on that optional conflict.
legacy-peer-deps=true
